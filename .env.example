# Solstice Cranker configuration.
#
# Copy to .env for local runs (.env is gitignored). In GitHub Actions these come from
# repository secrets and variables instead -- see docs/RUNBOOK.md.
#
# NOTHING IN THIS FILE IS A REAL VALUE. Never commit a filled-in .env.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Which entry of config/networks.json to use: devnet | calibnet | mainnet
NETWORK=calibnet

# Filecoin JSON-RPC endpoint. Overrides the default in config/networks.json.
# Use a public or rate-limited endpoint. Do not point this at a node whose RPC
# exposes admin or wallet methods -- the cranker never needs them.
RPC_URL=https://api.calibration.node.glif.io/rpc/v1

# Private key of the cranker wallet, 0x-prefixed.
# This wallet holds gas FIL and nothing else: no role, no permission, no multisig
# membership. See docs/WALLET.md -- generate it yourself, never paste it into a chat,
# an issue, or a log. In CI this is the CRANKER_PRIVATE_KEY repository secret.
CRANKER_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Contract addresses -- override config/networks.json
# ---------------------------------------------------------------------------
# Leave unset to use the committed addresses. Set these when the deployment moves,
# or run `npm run sync:deployments` to pull them from the upstream solstice repo.
# SRA_ADDRESS=0x...
# SWA_ADDRESS=0x...

# ---------------------------------------------------------------------------
# Pausing (rehearsal weekend handling -- solstice#68)
# ---------------------------------------------------------------------------

# Hard stop. Any truthy value and the cranker reads chain state, reports, and sends nothing.
# CRANK_PAUSED=1

# Comma-separated ISO dates (UTC) on which not to send.
#
# The calibnet rehearsal has TWO "nobody cranks" weekends: Q3/Q4 (Sat 26 and Sun 27 Sep)
# and Q10/Q11 (Sat 3 and Sun 4 Oct). Quarters bind at 19:00 UTC -- the 13:00 boundary plus
# POST_PERIOD 2h plus VERIFICATION_WINDOW 4h -- so pausing on those calendar dates is what
# suppresses the cranks for those quarters.
# CRANK_DISABLED_DAYS=2026-09-26,2026-09-27,2026-10-03,2026-10-04

# Comma-separated UTC weekday names, same effect on a recurring basis.
# CRANK_DISABLED_WEEKDAYS=Saturday,Sunday

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------

# Simulate and report but never broadcast. Useful for a first run against a new deployment.
# CRANK_DRY_RUN=1

# DIAGNOSTIC ONLY. Forces submitShares to target this quarter instead of the one the
# schedule resolves. Used by the devnet rehearsal to prove that a missed quarter really
# does revert NotLatestQuarter. The contract still guards it -- submitShares only ever
# accepts the latest bound quarter -- but while this is set the cranker will NOT submit
# the quarter that is actually due. It warns on every run and raises an alert. Never set
# it in production.
# CRANK_TARGET_QUARTER=8

# Max quarterlyGateCheck() calls in a single run while catching up after a gap. Default 8.
# CRANK_MAX_GATE_CATCHUP=8

# Warn when the wallet drops below this, in FIL. Defaults to the network's minBalanceFil.
# CRANK_MIN_BALANCE_FIL=0.1

# Where to append run records as NDJSON. Unset in production; the devnet demo sets it.
# CRANK_STATE_DIR=devnet/.state

# Confirmations to wait for after broadcasting. Defaults to the network's `confirmations`
# (1 on calibnet, 2 on mainnet).
# CRANK_CONFIRMATIONS=1

# debug | info (default) | warn | error. `debug` prints stack traces and per-call detail.
# CRANK_LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Watchdog (scripts/watchdog.mjs) -- the independent "did it actually land?" check
# ---------------------------------------------------------------------------
# The watchdog reads chain state only and never sends a transaction, so it runs with no
# CRANKER_PRIVATE_KEY at all. Do not give it one.
#
# Epochs to wait after a quarter binds before calling a missing crank overdue.
# Defaults to a quarter of the verification window, minimum 1 epoch.
# WATCHDOG_GRACE_EPOCHS=120

# ---------------------------------------------------------------------------
# Alerting -- all optional. With none set, alerts go to stdout and the Actions job summary.
# ---------------------------------------------------------------------------

# console (default) | sendgrid | resend | webhook. Comma-separate to use several.
# ALERT_TRANSPORT=sendgrid

ALERT_EMAIL_TO=michael@fil.org
ALERT_EMAIL_FROM=cranker@fil.org

# SENDGRID_API_KEY=YOUR_API_KEY_HERE
# RESEND_API_KEY=YOUR_API_KEY_HERE
# ALERT_WEBHOOK_URL=https://example.invalid/hook
