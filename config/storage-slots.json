      { "word": 0, "offsetBytes": 8, "bytes": 8, "name": "mirrorAQuarter", "type": "uint64", "note": "stores quarter + 1; 0 = never written" },
      { "word": 0, "offsetBytes": 16, "bytes": 8, "name": "mirrorBQuarter", "type": "uint64", "note": "stores quarter + 1; 0 = never written" }
