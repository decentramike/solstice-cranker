# Build/serve Mission Control against the bundled fixtures instead of the devnet server.
# Useful before devnet/server.mjs exists, and for screenshots.
# VITE_USE_FIXTURES=1

# Where the devnet server lives. Vite proxies /api here in dev, so no CORS config is needed.
# VITE_DEVNET_ORIGIN=http://127.0.0.1:8787

# Only needed if you serve the built bundle from somewhere that cannot proxy /api.
# VITE_API_BASE=http://127.0.0.1:8787
